# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# user-specific IDE config
/.idea

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/runtime artifacts
/.codex-run/

# external source snapshots
/external/

# large/static media assets
/public/videos/
/static/*
*.mp4
*.mov
*.webm
*.avi
*.rar
*.zip
*.7z
